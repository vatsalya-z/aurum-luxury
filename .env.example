# Google Search Console Verification Token (HTML Tag verification)
# Insert the content attribute value from Google Search Console: <meta name="google-site-verification" content="YOUR_TOKEN_HERE" />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools Verification Token
# Insert the token from Bing Webmaster Tools msvalidate.01 meta tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
